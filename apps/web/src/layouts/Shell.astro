---
import "../styles/global.css";
import CartIcon from "../components/icons/CartIcon.astro";
import { CartCount } from "../components/CartCount";

interface Props {
  title: string;
  description: string;
  canonical?: URL;
  image?: URL;
  ogType?: "website" | "article";
}

const {
  title,
  description,
  canonical,
  image,
  ogType = "website",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:," />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {image && <meta property="og:image" content={image} />}
    <meta
      name="twitter:card"
      content={image ? "summary_large_image" : "summary"}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Langsung ke konten
    </a>
    <header class="page-container flex flex-wrap items-center justify-between gap-4 py-6">
      <a class="inline-flex min-h-11 items-center font-semibold" href="/">
        Kodeva
      </a>
      <nav
        aria-label="Navigasi utama"
        class="flex flex-wrap items-center gap-x-4 gap-y-2"
      >
        <a class="inline-flex min-h-11 min-w-11 items-center" href="/blog">
          Blog
        </a>
        <a class="inline-flex min-h-11 items-center" href="/products">
          Katalog
        </a>
        <a
          class="relative inline-flex min-h-11 min-w-11 items-center justify-center font-semibold"
          href="/cart"
          aria-label="Keranjang"
        >
          <CartIcon />
          <CartCount client:idle />
        </a>
      </nav>
    </header>
    <main id="main" class="page-container pb-16" tabindex="-1">
      <slot />
    </main>
    <script>
      // T08 (R-020/R-021, D-045–D-047): initialize the dataLayer once per
      // document and capture the tab's first-touch UTM session attribute
      // before any island can read it. No network calls, no PII.
      import { captureTouch, initDataLayer } from "../lib/analytics";
      initDataLayer();
      captureTouch();
    </script>
  </body>
</html>
