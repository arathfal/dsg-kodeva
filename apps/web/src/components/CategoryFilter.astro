---
// Owner-directed catalog filter bar (S-036A): a full-width search input and a
// single row of category chips plus a price-sort picker, following the owner's
// reference layout. The chips are plain server-rendered links (D-034 state
// pattern); the form submits the trimmed search text and chosen sort order so
// state (kategori + q + harga) stays reflected in the URL. A small
// progressive-enhancement script debounces typed searches and submits the
// sort change; a visible fallback button only appears without JavaScript.
import {
  catalogCategories,
  catalogParamsHref,
  type CatalogHrefInput,
} from "../../../../shared/catalog.ts";
interface Props {
  active?: string;
  /** Query/state that must survive a category change. */
  preserved?: CatalogHrefInput;
}

const { active, preserved } = Astro.props;
const href = (categoryId?: string) =>
  catalogParamsHref({ category: categoryId, ...preserved });
const chips = [
  { href: href(undefined), label: "Semua", isActive: !active },
  ...catalogCategories.map((category) => ({
    href: href(category.id),
    label: category.name,
    isActive: active === category.id,
  })),
];
---

<nav aria-label="Filter kategori produk" class="md:min-w-0 md:flex-1">
  <ul class="no-scrollbar flex flex-nowrap gap-3 overflow-x-auto">
    {chips.map((item) => (
      <li>
        <a
          class:list={[
            "inline-flex min-h-11 shrink-0 items-center rounded-full border px-4 font-semibold whitespace-nowrap",
            item.isActive
              ? "border-primary/40 bg-primary/10 text-primary hover:text-primary"
              : "border-border bg-canvas text-ink hover:text-primary",
          ]}
          href={item.href}
          aria-current={item.isActive ? "page" : undefined}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
