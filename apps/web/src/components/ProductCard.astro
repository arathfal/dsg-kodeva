---
import type { ProductId } from "../../../../shared/content.ts";
import {
  BILLING_PERIOD,
  getCatalogEntry,
  startingPrice,
} from "../../../../shared/catalog.ts";
import type { Image } from "../lib/cms/models";
import { formatRupiah } from "../lib/format";
import ProductIcon from "./icons/ProductIcon.astro";
import CheckIcon from "./icons/CheckIcon.astro";
import CmsImage from "./CmsImage.astro";

interface Props {
  productId: ProductId;
  name: string;
  description: string;
  features: string[];
  image?: Image | null;
  href: string;
}

const { productId, name, description, features, image, href } = Astro.props;
const titleId = `product-${productId}`;
const entry = getCatalogEntry(productId);
const startPrice = entry ? startingPrice(entry) : undefined;
const promo =
  entry && entry.packages.some((offer) => offer.originalPrice !== undefined);
const quota =
  entry?.promoQuota === 0
    ? "Kuota promo habis"
    : entry
      ? `Sisa kuota promo: ${entry.promoQuota}`
      : undefined;
---

<article class="panel flex flex-col gap-4" aria-labelledby={titleId}>
  {image && (
    <div class="overflow-hidden rounded-card bg-soft">
      <CmsImage image={image} card />
    </div>
  )}
  <div class="flex items-center gap-3">
    <div class="text-primary">
      <ProductIcon id={productId} />
    </div>
    <h3 id={titleId} class="text-xl leading-tight font-semibold">
      {name}
    </h3>
    {promo && (
      <span class="ml-auto rounded-full bg-primary px-3 py-1 text-sm font-semibold text-canvas">
        Promo
      </span>
    )}
  </div>
  <p class="text-secondary">{description}</p>
  {features.length > 0 && (
    <ul class="flex-1 space-y-2">
      {features.map((feature) => (
        <li class="flex items-start gap-2 text-secondary">
          <span class="mt-0.5 shrink-0 text-primary">
            <CheckIcon />
          </span>
          <span>{feature}</span>
        </li>
      ))}
    </ul>
  )}
  {startPrice !== undefined && (
    <p class="text-ink">
      {entry!.packages[0].originalPrice && (
        <s class="block text-sm font-normal text-secondary">
          {formatRupiah(entry!.packages[0].originalPrice)}
        </s>
      )}
      <span class="text-lg font-semibold tabular-nums">
        Mulai {formatRupiah(startPrice)}
      </span>
      <span class="text-sm text-secondary"> / {BILLING_PERIOD}</span>
    </p>
  )}
  {quota && (
    <p class:list={["text-sm", entry?.promoQuota === 0 && "text-error"]}>
      {quota}
    </p>
  )}
  <a class="button mt-2 w-full md:w-auto" href={href}>
    Lihat Detail
  </a>
</article>
