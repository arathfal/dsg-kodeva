---
import Shell from "../../layouts/Shell.astro";
import { PackageSelector } from "../../components/PackageSelector";
import ScreenshotFigure from "../../components/ScreenshotFigure.astro";
import {
  BILLING_PERIOD,
  catalogResult,
  getCatalogCategory,
  getCatalogEntry,
  unitLabels,
} from "../../../../../shared/catalog.ts";
import { products } from "../../../../../shared/content.ts";
import { productSummaries } from "../../../../../shared/products.ts";

const { id } = Astro.params;
const result = catalogResult();
const entry = getCatalogEntry(id);
if (!entry) Astro.response.status = 404;
else if (result.status === "unavailable") Astro.response.status = 503;

const product = entry ? products.find((p) => p.id === entry.id) : undefined;
const summary = entry ? productSummaries[entry.id] : undefined;
const title = entry
  ? `${product!.name}: harga dan paket | Kodeva`
  : "Produk tidak ditemukan | Kodeva";
const description = summary
  ? `${summary.description} Harga langganan tahunan dengan paket Basic, Pro, dan Business.`
  : "Produk Kodeva tidak ditemukan.";
let canonical: URL | undefined;
let socialUrl: URL | undefined;
try {
  const origin = new URL(import.meta.env.PUBLIC_SITE_URL);
  if (["https:", "http:"].includes(origin.protocol)) {
    if (entry) canonical = new URL(`/products/${entry.id}`, origin.origin);
    if (entry) socialUrl = new URL(entry.screenshots[0].src, origin.origin);
  }
} catch {
  /* Missing configuration must not use an untrusted request origin. */
}
const quota =
  entry?.promoQuota === 0
    ? "Kuota promo habis"
    : entry
      ? `Sisa kuota promo: ${entry.promoQuota} lisensi`
      : undefined;
---

<Shell
  title={title}
  description={description}
  canonical={canonical}
  image={socialUrl}
  ogType={entry ? "website" : undefined}
>
  {entry && product && summary ? (
    <div class="space-y-10">
      <a class="inline-flex min-h-11 items-center text-sm" href="/products">
        ← Kembali ke katalog
      </a>
      <header class="max-w-3xl space-y-4">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-secondary">
          <span class="rounded-input border border-border px-2 py-0.5 font-semibold text-ink">
            {getCatalogCategory(entry.categoryId)?.name}
          </span>
          <span>
            · Lisensi {unitLabels[entry.unit]} · {BILLING_PERIOD}
          </span>
        </p>
        <h1 id="product-title" class="text-hero font-semibold tracking-tight">
          {product.name}
        </h1>
        <p class="max-w-prose text-secondary">{summary.description}</p>
      </header>
      <section
        aria-labelledby="purchase-title"
        class="grid items-start gap-8 md:grid-cols-2"
      >
        <h2
          id="purchase-title"
          class="text-section font-semibold md:col-span-2"
        >
          Pilih paket langganan
        </h2>
        <div class="panel space-y-5">
          <PackageSelector
            productId={entry.id}
            productName={product.name}
            offers={entry.packages}
            priceId="selected-price"
            client:load
          />
          <div class="mt-4 space-y-2 border-t border-border pt-3">
            <p
              class:list={[
                "font-semibold",
                entry.promoQuota === 0 && "text-error",
              ]}
            >
              {quota}
            </p>
            <p class="text-sm text-secondary">
              Kuota promo dipakai bersama oleh semua paket (Basic, Pro,
              Business) pada Promo Akhir Tahun.
            </p>
          </div>
        </div>
        <div class="panel space-y-4">
          <h3 class="text-lg font-semibold">Fitur utama</h3>
          <ul class="space-y-2">
            {summary.features.map((feature) => (
              <li class="flex items-start gap-2 text-secondary">
                <span class="mt-1 size-2 shrink-0 rounded-full bg-primary" />
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
      <section aria-labelledby="screens-title" class="space-y-6">
        <h2 id="screens-title" class="text-section font-semibold">
          Tampilan aplikasi
        </h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {entry.screenshots.map((shot) => (
            <ScreenshotFigure
              src={shot.src}
              alt={shot.alt}
              caption={shot.caption}
            />
          ))}
        </div>
        <p class="text-sm text-secondary">
          Gambar: ilustrasi antarmuka orisinal untuk assessment Kodeva; seluruh
          data fiktif.
        </p>
      </section>
      <footer class="border-t border-border pt-8 text-sm text-secondary">
        Seluruh penawaran merupakan ilustrasi assessment, bukan pembelian nyata.
      </footer>
    </div>
  ) : (
    <section
      class="max-w-prose space-y-6 py-16"
      aria-labelledby={
        result.status === "unavailable" ? "error-title" : "missing-title"
      }
    >
      {result.status === "unavailable" ? (
        <>
          <h1 id="error-title" class="text-section font-semibold">
            Produk sedang tidak dapat dimuat
          </h1>
          <p>Silakan coba lagi nanti.</p>
        </>
      ) : (
        <>
          <h1 id="missing-title" class="text-section font-semibold">
            Produk tidak ditemukan
          </h1>
          <p>
            Produk yang Anda buka tidak tersedia. Mungkin tautannya berubah atau
            produk sudah tidak dipasarkan.
          </p>
        </>
      )}
      <a class="button" href="/products">
        Buka katalog
      </a>
    </section>
  )}
</Shell>
