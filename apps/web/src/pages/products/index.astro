---
import Shell from "../../layouts/Shell.astro";
import { siteUrl } from "../../lib/seo";
import CatalogSearch from "../../components/catalog/CatalogSearch.astro";
import ProductCard from "../../components/ProductCard.astro";
import { CATALOG_PATH, products } from "../../../../../shared/content.ts";
import {
  catalogParamsHref,
  catalogResult,
  catalogSearchHits,
  getCatalogCategory,
  getCatalogSearch,
  getPriceSortId,
  productsInCategory,
  sortCatalogByPrice,
} from "../../../../../shared/catalog.ts";
import { productSummaries } from "../../../../../shared/products.ts";

// Bonus: kategori, q and harga live entirely in the URL (D-034 style:
// server-rendered links and a GET form, with a small owner-directed debounce
// script as progressive enhancement), so any combination can be shared as a
// link. Unknown categories still return 404; unknown sort values and
// blank/redundant searches fall back to the default view instead of failing.
const query = Astro.url.searchParams.get("kategori");
const selected =
  query !== null && query !== "" ? getCatalogCategory(query) : undefined;
const unknownCategory = query !== null && query !== "" && !selected;
const search = getCatalogSearch(Astro.url.searchParams.get("q"));
const priceSort = getPriceSortId(Astro.url.searchParams.get("harga"));
const result = catalogResult();
if (unknownCategory) Astro.response.status = 404;
if (result.status === "unavailable") Astro.response.status = 503;

const title = unknownCategory
  ? "Kategori tidak ditemukan | Kodeva"
  : result.status === "unavailable"
    ? "Katalog sedang tidak dapat dimuat | Kodeva"
    : "Katalog produk Kodeva";
const description =
  "Enam aplikasi Kodeva untuk usaha kecil: harga langganan tahunan, paket Basic/Pro/Business, dan kuota promo.";
const canonical = siteUrl("/products");

const base =
  result.status === "ok"
    ? selected
      ? productsInCategory(selected.id)
      : result.data
    : [];
// Sorting only applies when ?urutan is present; the default view keeps the
// approved fixture order.
const filtered = search ? catalogSearchHits(base, search) : base;
const visible = priceSort ? sortCatalogByPrice(filtered, priceSort) : filtered;
---

<Shell title={title} description={description} canonical={canonical}>
  {result.status === "unavailable" ? (
    <section class="max-w-prose space-y-6 py-16" aria-labelledby="error-title">
      <h1 id="error-title" class="text-section font-semibold">
        Katalog sedang tidak dapat dimuat
      </h1>
      <p>Silakan coba lagi nanti.</p>
      <a class="button" href="/products">
        Coba muat kembali
      </a>
    </section>
  ) : unknownCategory ? (
    <section
      class="max-w-prose space-y-6 py-16"
      aria-labelledby="missing-title"
    >
      <h1 id="missing-title" class="text-section font-semibold">
        Kategori tidak ditemukan
      </h1>
      <p>
        Tautan kategori mungkin salah atau sudah berubah. Gunakan filter
        kategori pada katalog.
      </p>
      <a class="button" href="/products">
        Buka katalog
      </a>
    </section>
  ) : (
    <div class="space-y-8">
      <header class="space-y-4">
        <h1 class="text-hero font-semibold tracking-tight">Katalog produk</h1>
        <p class="max-w-prose text-secondary">
          Harga langganan tahunan dalam rupiah. Pilih kategori untuk menyaring
          pilihan aplikasi.
        </p>
      </header>
      <CatalogSearch
        search={search}
        priceSort={priceSort}
        category={selected?.id}
        active={selected?.id}
      />
      {visible.length > 0 && (
        <p class="text-sm text-secondary">
          Menampilkan {visible.length} produk
        </p>
      )}
      {visible.length > 0 && (
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {visible.map((entry) => {
            const product = products.find((p) => p.id === entry.id)!;
            return (
              <ProductCard
                productId={entry.id}
                name={product.name}
                description={productSummaries[entry.id].description}
                features={productSummaries[entry.id].features}
                href={`${CATALOG_PATH}/${entry.id}`}
              />
            );
          })}
        </div>
      )}
      {search && visible.length === 0 ? (
        <section
          class="panel max-w-prose space-y-4"
          aria-labelledby="empty-search-title"
        >
          <h2 id="empty-search-title" class="text-xl font-semibold">
            Tidak ada produk yang cocok
          </h2>
          <p>
            Tidak ada aplikasi dengan pencarian “{search}”
            {selected ? ` di kategori ${selected.name}` : " di katalog"}. Coba
            kata kunci lain, atau hapus pencarian untuk melihat kembali seluruh
            produk.
          </p>
          <a
            class="button"
            href={catalogParamsHref({ category: selected?.id, priceSort })}
          >
            Hapus pencarian
          </a>
        </section>
      ) : null}
      {search === undefined && visible.length === 0 ? (
        <section
          class="panel max-w-prose space-y-4"
          aria-labelledby="empty-title"
        >
          <h2 id="empty-title" class="text-xl font-semibold">
            Belum ada produk di kategori ini
          </h2>
          <p>
            Kategori “{selected?.name}” masih kosong untuk kampanye ini. Lihat
            pilihan aplikasi yang tersedia di katalog.
          </p>
          <a class="button" href="/products">
            Lihat semua produk
          </a>
        </section>
      ) : null}
    </div>
  )}
</Shell>
