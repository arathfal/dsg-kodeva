---
import Shell from "../layouts/Shell.astro";
import { siteUrl } from "../lib/seo";
import { CartView } from "../components/cart/CartView";
import { CART_PATH } from "../../../../shared/content.ts";

// The static shell is server
// rendered; contents, notices and totals come from the validated cart island.
const title = "Keranjang | Kodeva";
const description =
  "Keranjang langganan tahunan Kodeva dengan penambahan dan pengurangan jumlah lisensi, kuota promo antar paket, dan subtotal otomatis.";
const canonical = siteUrl(CART_PATH);
---

<Shell title={title} description={description} canonical={canonical}>
  <div class="space-y-8">
    <header class="max-w-prose space-y-3">
      <h1 class="text-hero font-semibold tracking-tight">Keranjang</h1>
      <p class="text-secondary">
        Semua paket satu produk memakai kuota promo yang sama; jumlah total
        lisensi produk tidak boleh melebihi sisa kuota.
      </p>
    </header>
    <CartView client:load />
  </div>
</Shell>
