# Public content identifiers. Content reads are server-side and anonymous.
SANITY_PROJECT_ID=example1
SANITY_DATASET=production
# Separate private dataset. No browser variable or token is needed in T02.
SANITY_LEADS_DATASET=leads
PUBLIC_SITE_URL=http://localhost:4321
# T03 will need an approved scoped write token in a server-only variable.
# Never use PUBLIC_ or SANITY_STUDIO_ prefixes for credentials.
